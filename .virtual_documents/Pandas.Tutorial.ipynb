#Grouping and Aggrigation in pandas

df.groupby("country")["income"].mean()
df.groupby("country")["income"].min()
df.groupby("country")["income"].max()

df.groupby("gender")["income"].mean()

df.groupby("country")["income"].agg(["mean","max","min"])
df.groupby("country")["income"].aggregate(avg_salary="mean",max_salary="max",min_salary="min")

df.groupby("country").agg({
    "income" : "mean",
    "age" : "mean"
})

df.groupby("country").agg({
    "income" : "max",
    "age" : "mean"
})

df.groupby("country").agg(
    avg_salary=("income" , "mean"),
    Min_age=("age" , "min")
)


df = pd.DataFrame({
    "country": ["USA", "USA", "India", "India"],
    "year": [2020, 2021, 2020, 2021],
    "sales": [100, 120, 90, 110],
    "profit": [20, 25, 18, 22]
})
#melt fnx ---> convert wide to long formate
melted_df = df.melt(
    id_vars=["country","year"],
    value_vars=["sales","profit"],
    var_name="metrices",
    value_name="value"
)

#pivot fnx ---> convert long to wide formate

melted_df.pivot(
    index=["country","year"],
    columns="metrices",
    values="value"
)


